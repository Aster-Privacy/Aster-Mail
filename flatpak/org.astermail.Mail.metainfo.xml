<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>org.astermail.Mail</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-or-later</project_license>

  <name>Aster Mail</name>
  <summary>End-to-end encrypted email</summary>

  <developer id="org.astermail">
    <name>Aster Communications Inc.</name>
  </developer>

  <description>
    <p>
      Aster Mail is end-to-end encrypted email. Your messages are encrypted on your device before they reach the server, so only you and the people you write to can read them. Mail between Aster accounts also uses post-quantum encryption.
    </p>
    <p>With Aster Mail, you can:</p>
    <ul>
      <li>Keep your real address private with aliases</li>
      <li>Send and receive mail at your own domain</li>
      <li>Exchange encrypted mail with PGP users at any provider</li>
      <li>Import your mail and contacts from another provider</li>
    </ul>
    <p>
      The free plan includes 10 GB of storage, 5 aliases, and one custom domain. You need an Aster account to use the app.
    </p>
  </description>

  <launchable type="desktop-id">org.astermail.Mail.desktop</launchable>

  <url type="homepage">https://astermail.org</url>
  <url type="bugtracker">https://github.com/Aster-Privacy/Aster-Mail/issues</url>
  <url type="vcs-browser">https://github.com/Aster-Privacy/Aster-Mail</url>

