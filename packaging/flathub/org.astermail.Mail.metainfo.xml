    </screenshot>
    <screenshot>
      <caption>Read a message in the reading pane</caption>
      <image>https://raw.githubusercontent.com/Aster-Privacy/Aster-Mail/v@VERSION@/packaging/flathub/screenshots/screenshot_02_reading.png</image>
    </screenshot>
