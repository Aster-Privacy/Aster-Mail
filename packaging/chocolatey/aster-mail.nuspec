<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>aster-mail</id>
    <version>@VERSION@</version>
    <packageSourceUrl>https://github.com/Aster-Privacy/Aster-Mail/tree/main/packaging/chocolatey</packageSourceUrl>
    <owners>Aster Communications Inc</owners>
    <title>Aster Mail</title>
    <authors>Aster Communications Inc</authors>
    <projectUrl>https://astermail.org/</projectUrl>
    <iconUrl>https://raw.githubusercontent.com/Aster-Privacy/Aster-Mail/01a79449e4706b43cd790419736ed24bfbea95c0/src-tauri/icons/128x128.png</iconUrl>
    <licenseUrl>https://github.com/Aster-Privacy/Aster-Mail/blob/main/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <projectSourceUrl>https://github.com/Aster-Privacy/Aster-Mail</projectSourceUrl>
    <bugTrackerUrl>https://github.com/Aster-Privacy/Aster-Mail/issues</bugTrackerUrl>
    <tags>aster-mail email encryption privacy openpgp foss</tags>
    <summary>End-to-end encrypted email client for your Aster account</summary>
    <description>Aster Mail is the desktop app for Aster, a free, open-source, end-to-end encrypted email service. Aster encrypts your messages, subject lines, and attachments on your device, so Aster can't read your email.

Messages between Aster accounts are end-to-end encrypted with OpenPGP and use ML-KEM-768 key exchange, which protects them against attackers who store encrypted messages today to decrypt them later. Your keys are portable, so you can export them and use them with any OpenPGP app.

To use Aster Mail, you need an Aster account. You can create a free account at astermail.org without a phone number or a recovery email address.</description>
    <releaseNotes>https://github.com/Aster-Privacy/Aster-Mail/releases/tag/v@VERSION@</releaseNotes>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
