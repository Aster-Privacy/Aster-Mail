pkgbase = aster-mail-bin
	pkgdesc = End-to-end encrypted email client for your Aster account
	pkgver = @VERSION@
	pkgrel = 1
	url = https://astermail.org/
	arch = x86_64
	arch = aarch64
	license = AGPL-3.0-or-later
	depends = cairo
	depends = dbus
	depends = gdk-pixbuf2
	depends = glib2
	depends = gtk3
	depends = hicolor-icon-theme
	depends = libayatana-appindicator
	depends = libsoup3
	depends = webkit2gtk-4.1
	provides = aster-mail
	conflicts = aster-mail
	options = !strip
	options = !debug
	source_x86_64 = aster-mail-bin-@VERSION@-x86_64.deb::https://github.com/Aster-Privacy/Aster-Mail/releases/download/v@VERSION@/Aster-Mail-amd64.deb
	sha256sums_x86_64 = @DEB_AMD64_SHA256@
	source_aarch64 = aster-mail-bin-@VERSION@-aarch64.deb::https://github.com/Aster-Privacy/Aster-Mail/releases/download/v@VERSION@/Aster-Mail-arm64.deb
	sha256sums_aarch64 = @DEB_ARM64_SHA256@

pkgname = aster-mail-bin
